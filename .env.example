# BOX-BOX Environment Configuration

# -----------------
# SECURITY
# -----------------
# Origins allowed to connect to the backend (Comma separated)
# Example: https://boxbox.ai,https://www.boxbox.ai
CORS_ORIGINS=http://localhost:5173,http://localhost
# Set the public IP or domain of your EC2 instance for the frontend build
VITE_API_BASE_URL=http://your-ec2-ip:8000

# -----------------
# BACKEND RESOURCES
# -----------------
# Number of Gunicorn workers (Default is bounded by WORKERS_PER_CORE and MAX_DEFAULT_WORKERS)
# WEB_CONCURRENCY=5
# WORKERS_PER_CORE=1
# MAX_DEFAULT_WORKERS=4

# Timeout for heavy Monte Carlo simulations
GUNICORN_TIMEOUT=120

# -----------------
# DATABASE (If applicable)
# -----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password

# -----------------
# LOGGING
# -----------------
LOG_LEVEL=info
